# Copia este archivo como .env y completa los valores.

# Chat: la key se crea gratis en https://build.nvidia.com y empieza con nvapi-
NVIDIA_API_KEY=

# Formulario del chat: los datos llegan por correo con Resend (https://resend.com).
RESEND_API_KEY=
# Remitente: un correo de un dominio verificado en Resend, por ejemplo
# "abeeFlow Web <web@abeeflow.com>". Sin esto se usa el remitente de prueba
# de Resend, que solo entrega al correo dueño de la cuenta.
LEAD_FROM=
# A quién llega (separados por coma). Por defecto: contacto@ y maria@abeeflow.com
LEAD_TO=
